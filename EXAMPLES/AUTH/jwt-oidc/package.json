{
  "name": "jwt-oidc",
  "version": "1.0.0",
  "description": "Verify OIDC access tokens with jose in Express 5 and separate authentication from authorization",
  "private": true,
  "type": "module",
  "author": "Mike Bild <mike.bild@gmail.com>",
  "license": "MIT",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "start": "node src/main.ts",
    "start:solution": "node solution/main.ts",
    "dev": "ENABLE_DEV_ISSUER=true node src/main.ts",
    "dev:solution": "ENABLE_DEV_ISSUER=true node solution/main.ts",
    "test": "vitest run --dir src",
    "test:solution": "vitest run --dir solution",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write src solution README.md"
  },
  "dependencies": {
    "express": "^5.1.0",
    "jose": "^6.2.13"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "prettier": "^3.6.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
