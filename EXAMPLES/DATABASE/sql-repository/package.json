{
  "name": "sql-repository",
  "version": "1.0.0",
  "description": "Type-safe, injection-safe SQL with postgres.js behind a small repository port",
  "private": true,
  "type": "module",
  "author": "Mike Bild <mike.bild@gmail.com>",
  "license": "MIT",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/main.ts",
    "migrate": "node --env-file-if-exists=.env src/migrate.ts migrations",
    "migrate:solution": "node --env-file-if-exists=.env src/migrate.ts migrations solution/migrations",
    "test": "node --test \"src/**/*.test.ts\"",
    "test:solution": "node --test \"solution/**/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write src solution README.md"
  },
  "dependencies": {
    "loglevel": "^1.9.2",
    "postgres": "^3.4.9"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3"
  }
}
