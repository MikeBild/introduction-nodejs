{
  "name": "event-sourcing-aws",
  "version": "1.0.0",
  "description": "Event Store auf DynamoDB, Projektion als Stream-Handler",
  "private": true,
  "type": "module",
  "author": "Mike Bild <mike.bild@gmail.com>",
  "license": "MIT",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "start": "node src/main.ts",
    "start:solution": "node solution/main.ts",
    "test": "vitest run",
    "test:start": "vitest run src",
    "test:solution": "vitest run solution",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write src solution README.md vitest.config.ts"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.1159.0",
    "@aws-sdk/lib-dynamodb": "^3.1159.0",
    "@aws-sdk/util-dynamodb": "^3.996.9"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.164",
    "@types/node": "^26.6.6",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
