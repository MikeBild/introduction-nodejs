{
  "name": "shop",
  "version": "1.0.0",
  "description": "The workshop shop as an npm monorepo: workspaces, linked install, install scripts and an internal CLI",
  "private": true,
  "type": "module",
  "author": "Mike Bild <mike.bild@gmail.com>",
  "license": "MIT",
  "engines": {
    "node": ">=26"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=26",
      "onFail": "error"
    },
    "packageManager": {
      "name": "npm",
      "version": ">=12",
      "onFail": "error"
    }
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "start": "npm start -w @shop/api",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "format": "prettier --write apps packages solution/apps solution/packages README.md"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "prettier": "^3.6.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
