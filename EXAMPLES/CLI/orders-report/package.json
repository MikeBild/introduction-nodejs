{
  "name": "orders-report",
  "version": "1.0.0",
  "description": "A composable CLI with parseArgs, stdin/stdout, exit codes and Ctrl+C handling",
  "private": true,
  "type": "module",
  "author": "Mike Bild <mike.bild@gmail.com>",
  "license": "MIT",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "start": "node src/cli.ts data/orders.csv",
    "start:solution": "node solution/cli.ts data/orders.csv --limit 3",
    "test": "node --test \"src/**/*.test.ts\"",
    "test:solution": "node --test \"solution/**/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write src solution README.md"
  },
  "dependencies": {
    "loglevel": "^1.9.2"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3"
  }
}
