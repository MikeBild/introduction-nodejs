{
  "name": "orders-report",
  "version": "1.0.0",
  "description": "A composable CLI with parseArgs, stdin/stdout, exit codes and Ctrl+C handling",
  "private": true,
  "type": "module",
  "author": "Mike Bild <mike.bild@gmail.com>",
  "license": "MIT",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "start": "node src/cli.ts data/orders.csv",
    "start:solution": "node solution/cli.ts data/orders.csv --limit 3",
    "test": "vitest run --dir src",
    "test:solution": "vitest run --dir solution",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write src solution README.md"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "prettier": "^3.6.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
