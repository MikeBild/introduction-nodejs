{
  "name": "profiling",
  "version": "1.0.0",
  "description": "Measure before you change: load test, CPU profile and heap snapshots for a slow Node.js endpoint",
  "private": true,
  "type": "module",
  "author": "Mike Bild <mike.bild@gmail.com>",
  "license": "MIT",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "start": "node src/main.ts",
    "start:solution": "node solution/main.ts",
    "profile": "node --cpu-prof --cpu-prof-dir=profiles src/main.ts",
    "heap": "node --heapsnapshot-signal=SIGUSR2 --diagnostic-dir=profiles src/main.ts",
    "load": "npx --yes autocannon -c 50 -d 10 \"http://localhost:3000/report?month=2026-03\"",
    "bench": "node src/bench.ts",
    "test": "vitest run --dir src",
    "test:solution": "vitest run --dir solution",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write src solution README.md"
  },
  "dependencies": {
    "express": "^5.1.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "prettier": "^3.6.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
