{
  "name": "typed-config",
  "version": "1.0.0",
  "description": "Load configuration from the environment once, parse it with zod and keep secrets out of code and logs",
  "private": true,
  "type": "module",
  "author": "Mike Bild <mike.bild@gmail.com>",
  "license": "MIT",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/main.ts",
    "start:solution": "node --env-file-if-exists=.env solution/main.ts",
    "test": "node --test \"src/**/*.test.ts\"",
    "test:solution": "node --test \"solution/**/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write src solution README.md"
  },
  "dependencies": {
    "loglevel": "^1.9.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3"
  }
}
